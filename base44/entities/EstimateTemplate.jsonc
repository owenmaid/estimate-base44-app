{
  "name": "EstimateTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name — must be unique and not 'Est_Template'"
    },
    "description": {
      "type": "string",
      "description": "Description of this estimate template"
    },
    "source_estimate_number": {
      "type": "string",
      "description": "The estimate number this template was created from"
    },
    "client_info": {
      "type": "object",
      "description": "Snapshot of client/project metadata (client_name, project_number, etc.)",
      "additionalProperties": true
    },
    "line_items": {
      "type": "array",
      "description": "Full list of line items including __SECTION__ markers and bracket headers",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          },
          "markup": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "total": {
            "type": "number",
            "minimum": 0
          },
          "_isSummary": {
            "type": "boolean",
            "description": "Marks the persisted summary section row"
          },
          "tax_rate": {
            "type": "number",
            "description": "Tax rate stored on the summary row",
            "minimum": 0,
            "maximum": 100
          },
          "discount": {
            "type": "number",
            "description": "Discount stored on the summary row",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "description": "Stable line-item identifier"
          },
          "calculation_code": {
            "type": "string",
            "description": "Stable business-rule code; labels may change without changing calculations"
          }
        }
      }
    },
    "logo_urls": {
      "type": "object",
      "description": "Logo URLs at time of template creation",
      "additionalProperties": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
