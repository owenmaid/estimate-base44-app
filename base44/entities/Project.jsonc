{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "project_number": {
      "type": "string",
      "description": "Project number or identifier"
    },
    "client": {
      "type": "string",
      "description": "Client name"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "on_hold",
        "completed"
      ],
      "default": "planning",
      "description": "Current project status"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Project start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Project end date"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Progress percentage 0-100"
    },
    "tasks": {
      "type": "number",
      "default": 0,
      "description": "Total number of tasks"
    },
    "done": {
      "type": "number",
      "default": 0,
      "description": "Number of completed tasks"
    },
    "description": {
      "type": "string",
      "description": "Project description or notes"
    },
    "task_list": {
      "type": "array",
      "description": "List of tasks/items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "assignee": {
            "type": "string",
            "description": "Team member assigned to this task"
          },
          "done": {
            "type": "boolean"
          },
          "quantity": {
            "type": "number"
          },
          "cost": {
            "type": "number"
          },
          "markup": {
            "type": "number"
          },
          "tax_pct": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "tax_amount": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "schedule_grid": {
      "type": "object",
      "description": "Scheduled manpower assignments by date and row",
      "additionalProperties": true
    },
    "schedule_rows": {
      "type": "array",
      "description": "Row configuration for manpower schedule",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "equipment_grid": {
      "type": "object",
      "description": "Scheduled equipment assignments by date and row",
      "additionalProperties": true
    },
    "equipment_rows": {
      "type": "array",
      "description": "Row configuration for equipment schedule",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "type_grid": {
      "type": "object",
      "description": "Type selections per date in the equipment schedule",
      "additionalProperties": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}