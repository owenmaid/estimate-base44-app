{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "settings": {
      "type": "object",
      "description": "User preferences and app configuration",
      "additionalProperties": true
    }
  },
  "required": [
    "role"
  ]
}