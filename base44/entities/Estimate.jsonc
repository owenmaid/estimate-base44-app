{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string",
      "description": "Unique estimate number"
    },
    "client_name": {
      "type": "string",
      "description": "Client or company name"
    },
    "client_email": {
      "type": "string",
      "description": "Client email address"
    },
    "client_phone": {
      "type": "string",
      "description": "Client phone number"
    },
    "client_address": {
      "type": "string",
      "description": "Client address"
    },
    "project_name": {
      "type": "string",
      "description": "Name of the linked project"
    },
    "project_number": {
      "type": "string",
      "description": "Project number or identifier"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Project start date captured on the estimate"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Project end date captured on the estimate"
    },
    "description": {
      "type": "string",
      "description": "General description or notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "declined",
        "expired"
      ],
      "default": "draft",
      "description": "Current status of the estimate"
    },
    "line_items": {
      "type": "array",
      "description": "List of line items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "markup": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "_isSummary": {
            "type": "boolean",
            "description": "Marks the persisted summary section row"
          },
          "tax_rate": {
            "type": "number",
            "description": "Tax rate stored on the summary row"
          },
          "discount": {
            "type": "number",
            "description": "Discount stored on the summary row"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Sum of all line items"
    },
    "tax_rate": {
      "type": "number",
      "description": "Tax rate as a percentage"
    },
    "tax_amount": {
      "type": "number",
      "description": "Calculated tax amount"
    },
    "discount": {
      "type": "number",
      "description": "Discount amount"
    },
    "total": {
      "type": "number",
      "description": "Final total after tax and discount"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the estimate"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or terms"
    },
    "info_signal_logo": {
      "type": "string",
      "description": "URL for InfoSignal logo"
    },
    "dyna_vent_logo": {
      "type": "string",
      "description": "URL for DynaVent logo"
    }
  },
  "required": [
    "client_name",
    "project_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}