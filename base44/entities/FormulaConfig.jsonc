{
  "name": "FormulaConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Human-readable label for this formula."
    },
    "formula_expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[0-9a-zA-Z_+\\-*/(). \\t]+$",
      "description": "Arithmetic expression. Evaluated by safeEvalMath only."
    },
    "variables": {
      "type": "object",
      "description": "Variable name to default numeric value.",
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 50
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "name",
    "formula_expression"
  ],
  "additionalProperties": false,
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}